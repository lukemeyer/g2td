{
  "name": "g2td",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "play": "vite --config vite.play.config.ts",
    "build:play": "tsc --noEmit && vite build --config vite.play.config.ts",
    "simulate": "evenhub-simulator http://localhost:5173",
    "balance": "node tools/balance.ts",
    "pack": "npm run build && evenhub pack app.json dist -o g2td.ehpk --sdk-ver 0.0.16",
    "check": "npm run build && npm run balance && evenhub pack app.json dist -o g2td.ehpk --sdk-ver 0.0.16"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@evenrealities/pretext": "^0.1.4"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
